    "PhysicalTableMap": {
     "1cd7e7ae-0849-4c65-949c-7569444e309c": {
      "CustomSql": {
       "Columns": [
        {
         "Id": "new_custo-billing_m-be111c",
         "Name": "billing_month",
         "Type": "DATETIME"
        },
        {
         "Id": "new_custo-usage_dat-f45846",
         "Name": "usage_date",
         "Type": "DATETIME"
        },
        {
         "Id": "new_custo-user_name-586914",
         "Name": "user_name",
         "Type": "STRING"
        },
        {
         "Id": "new_custo-role_name-066cb6",
         "Name": "role_name",
         "Type": "STRING"
        },
        {
         "Id": "new_custo-model_id-8e32e2",
         "Name": "model_id",
         "Type": "STRING"
        },
        {
         "Id": "new_custo-token_kin-71232d",
         "Name": "token_kind",
         "Type": "STRING"
        },
        {
         "Id": "new_custo-tokens-857680",
         "Name": "tokens",
         "SubType": "FLOAT",
         "Type": "DECIMAL"
        },
        {
         "Id": "new_custo-cost_usd-e2a303",
         "Name": "cost_usd",
         "SubType": "FLOAT",
         "Type": "DECIMAL"
        }
       ],
       "DataSourceArn": {
        "Fn::GetAtt": [
         "DataSource",
         "Arn"
        ]
       },
       "Name": "New custom SQL",
       "SqlQuery": "SELECT\n  date_parse(billing_period, '%Y-%m')                     AS billing_month,\n  CAST(line_item_usage_start_date AS date)                AS usage_date,\n  regexp_extract(line_item_iam_principal, '[^/]+$')       AS user_name,\n  regexp_extract(line_item_iam_principal, 'assumed-role/([^/]+)/', 1) AS role_name,\n  regexp_extract(line_item_resource_id, '[^/]+$')         AS model_id,\n  CASE\n    WHEN regexp_replace(lower(line_item_usage_type), '[-_]', '') LIKE '%cacheread%'  THEN 'cache_read'\n    WHEN regexp_replace(lower(line_item_usage_type), '[-_]', '') LIKE '%cachewrite%' THEN 'cache_write'\n    WHEN lower(line_item_usage_type) LIKE '%input%'  THEN 'input'\n    WHEN lower(line_item_usage_type) LIKE '%output%' THEN 'output'\n    ELSE 'other'\n  END                                                     AS token_kind,\n  sum(line_item_usage_amount * CASE pricing_unit\n        WHEN '1M tokens' THEN 1000000\n        WHEN '1K tokens' THEN 1000\n        ELSE 1 END)                                       AS tokens,\n  sum(line_item_unblended_cost)                           AS cost_usd\nFROM cur.cur2\nWHERE line_item_iam_principal IS NOT NULL\n  AND line_item_iam_principal <> ''\n  AND line_item_line_item_type = 'Usage'\nGROUP BY 1, 2, 3, 4, 5, 6"
      }
     }
    },
