{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "Amazon Quick dashboard: Bedrock cost per IAM principal from CUR 2.0 (requires Athena table cur.cur2)",
 "Parameters": {
  "IdentityRegion": {
   "Default": "ap-northeast-1",
   "Description": "Quick identity region of this account",
   "Type": "String"
  },
  "ResourceIdPrefixForAllResources": {
   "Default": "",
   "Description": "Resource id prefix for all resources",
   "Type": "String"
  },
  "DashboardName": {
   "Default": "Bedrock ユーザー別コスト",
   "Description": "Name for dashboard:bedrock-user-cost",
   "Type": "String"
  },
  "DataSourceName": {
   "Default": "cur2-athena",
   "Description": "Name for datasource:bedrock-cur2-athena",
   "Type": "String"
  },
  "DataSourceWorkGroup": {
   "Default": "primary",
   "Description": "Athena workgroup that has a query result location",
   "Type": "String"
  },
  "DataSetName": {
   "Default": "bedrock-user-cost",
   "Description": "Name for dataset:bedrock-user-cost-dataset",
   "Type": "String"
  },
  "QuickUserArn": {
   "Type": "String",
   "Description": "ARN of the Quick user who owns the assets (e.g. arn:aws:quicksight:ap-northeast-1:111122223333:user/default/your-user)"
  }
 },
 "Resources": {
  "Dashboard": {
   "Properties": {
    "AwsAccountId": {
     "Fn::Sub": "${AWS::AccountId}"
    },
    "DashboardId": {
     "Fn::Sub": "${ResourceIdPrefixForAllResources}bedrock-user-cost"
    },
    "DashboardPublishOptions": {
     "AdHocFilteringOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "DataPointDrillUpDownOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "DataPointMenuLabelOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "DataPointTooltipOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "DataQAEnabledOption": {
      "AvailabilityStatus": "DISABLED"
     },
     "DataStoriesSharingOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "ExecutiveSummaryOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "ExportToCSVOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "ExportWithHiddenFieldsOption": {
      "AvailabilityStatus": "DISABLED"
     },
     "SheetControlsOption": {
      "VisibilityState": "EXPANDED"
     },
     "SheetLayoutElementMaximizationOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "VisualAxisSortOption": {
      "AvailabilityStatus": "ENABLED"
     },
     "VisualMenuOption": {
      "AvailabilityStatus": "ENABLED"
     }
    },
    "Definition": {
     "CalculatedFields": [
      {
       "DataSetIdentifier": "cost",
       "Expression": "ifelse(locate(toLower({model_id}), 'fable') > 0, 'Fable', locate(toLower({model_id}), 'opus') > 0, 'Opus', locate(toLower({model_id}), 'sonnet') > 0, 'Sonnet', locate(toLower({model_id}), 'haiku') > 0, 'Haiku', locate(toLower({model_id}), 'kimi') > 0, 'Kimi', 'Other')",
       "Name": "model_family"
      },
      {
       "DataSetIdentifier": "cost",
       "Expression": "concat(toString(extract('YYYY', {billing_month})), '-', ifelse(extract('MM', {billing_month}) < 10, concat('0', toString(extract('MM', {billing_month}))), toString(extract('MM', {billing_month}))))",
       "Name": "month_label"
      }
     ],
     "DataSetIdentifierDeclarations": [
      {
       "DataSetArn": {
        "Fn::GetAtt": [
         "DataSet",
         "Arn"
        ]
       },
       "Identifier": "cost"
      }
     ],
     "FilterGroups": [
      {
       "CrossDataset": "SINGLE_DATASET",
       "FilterGroupId": "fg-s1-month",
       "Filters": [
        {
         "CategoryFilter": {
          "Column": {
           "ColumnName": "month_label",
           "DataSetIdentifier": "cost"
          },
          "Configuration": {
           "FilterListConfiguration": {
            "MatchOperator": "CONTAINS",
            "NullOption": "NON_NULLS_ONLY",
            "SelectAllOptions": "FILTER_ALL_VALUES"
           }
          },
          "FilterId": "f-s1-month"
         }
        }
       ],
       "ScopeConfiguration": {
        "SelectedSheets": {
         "SheetVisualScopingConfigurations": [
          {
           "Scope": "SELECTED_VISUALS",
           "SheetId": "sheet-summary",
           "VisualIds": [
            "s1-kpi-cost",
            "s1-kpi-users",
            "s1-kpi-tokens",
            "s1-bar-user",
            "s1-bar-model",
            "s1-line-daily"
           ]
          }
         ]
        }
       },
       "Status": "ENABLED"
      },
      {
       "CrossDataset": "SINGLE_DATASET",
       "FilterGroupId": "fg-s2-month",
       "Filters": [
        {
         "CategoryFilter": {
          "Column": {
           "ColumnName": "month_label",
           "DataSetIdentifier": "cost"
          },
          "Configuration": {
           "FilterListConfiguration": {
            "MatchOperator": "CONTAINS",
